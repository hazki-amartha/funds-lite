{
  "name": "@funds/funds-lite",
  "version": "1.0.0",
  "description": "FunDS Lite design system — Amartha Financial",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
