    "postbuild": "cp ../src/funds-lite/components/styles.css dist/styles.css",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.figma.com/npm/63930366-33d5-4ef4-b47b-457356de8794/registry/"
  },
  "devDependencies": {
    "@types/react": "^18",
    "tsup": "^8",
    "typescript": "^5"
  }
}
